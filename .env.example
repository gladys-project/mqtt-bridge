# Local Compose: copy to .env beside compose.yml and replace placeholders.
# Server: use one shared /etc/gladys/gladys.env outside Git for all Gladys stacks.
# Select it with docker compose --env-file /etc/gladys/gladys.env.
# Each service should forward only its declared settings from this shared file.
# Container brokers on the shared network: kafka:29092 and mosquitto:1883.
# Host-run JVM: localhost:9092 and localhost:1883; explicitly export values to the process.
# The current local MQTT connection is anonymous; authentication is not configured yet.
SPRING_KAFKA_BOOTSTRAPSERVERS=<kafka-host:port>
BRIDGE_MQTT_IDENTIFIER=<unique-bridge-instance-id>
BRIDGE_MQTT_HOST=<mqtt-host>
BRIDGE_MQTT_PORT=<mqtt-port>
# For authenticated Kafka also set standard spring.kafka properties, for example:
# SPRING_KAFKA_SECURITY_PROTOCOL=<SASL_SSL>
# SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=<broker-sasl-mechanism>
# SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=<jaas-config-with-credentials>

# Subscription QoS and MQTT/Kafka topic overrides (Compose enables the deployed startup profile).
# BRIDGE_MQTT_QOS=<0-or-1-or-2>
# BRIDGE_MQTT_TELEMETRYTOPIC=<mqtt-subscription-filter>
# BRIDGE_TOPICS_TELEMETRY=<raw-kafka-topic>

# Shared Compose settings (optional; consumed by Compose, not forwarded to the bridge).
# GLADYS_NETWORK=<shared-network-name>
# KAFKA_HOST_PORT=<kafka-host-port>
# MQTT_HOST_PORT=<mqtt-host-port>
# BRIDGE_HTTP_PORT=<bridge-host-port>
# BRIDGE_IMAGE=<bridge-image-name>

# Optional MongoDB infrastructure and plant device data service.
# Use two different random URL-safe passwords and keep actual values outside Git.
# GLADYS_MONGO_ROOT_PASSWORD=<mongo-admin-password>
# GLADYS_MONGO_PLANT_DEVICE_PASSWORD=<plant-device-mongo-password>
# SPRING_MONGODB_URI=mongodb://plant_device_data:${GLADYS_MONGO_PLANT_DEVICE_PASSWORD}@mongo:27017/plant_device_data
# DEVICE_DATA_TOPIC=<device-data-topic>
# PLANT_DEVICE_DATA_GROUP=<dedicated-consumer-group>
# PLANT_DEVICE_DATA_HTTP_PORT=<host-http-port>
