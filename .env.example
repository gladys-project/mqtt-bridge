# Local Compose: copy to .env beside compose.yml and replace placeholders.
# Server: keep the file outside Git, e.g. /etc/gladys/mqtt-kafka-bridge.env, and set BRIDGE_ENV_FILE.
# Container brokers on the shared network: kafka:29092 and mosquitto:1883.
# Host-run JVM: localhost:9092 and localhost:1883; explicitly export values to the process.
# The current local MQTT connection is anonymous; authentication is not configured yet.
SPRING_KAFKA_BOOTSTRAPSERVERS=<kafka-host:port>
BRIDGE_MQTT_IDENTIFIER=<unique-bridge-instance-id>
BRIDGE_MQTT_HOST=<mqtt-host>
BRIDGE_MQTT_PORT=<mqtt-port>
# For authenticated Kafka also set standard spring.kafka properties, for example:
# SPRING_KAFKA_SECURITY_PROTOCOL=<SASL_SSL>
# SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=<broker-sasl-mechanism>
# SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=<jaas-config-with-credentials>

# Subscription QoS and MQTT/Kafka topic overrides (subscription starts only when explicitly requested).
# BRIDGE_MQTT_QOS=<0-or-1-or-2>
# BRIDGE_MQTT_TELEMETRYTOPIC=<mqtt-subscription-filter>
# BRIDGE_TOPICS_TELEMETRY=<raw-kafka-topic>
