# Copy to .env and replace placeholders before explicitly exporting to the app process.
# For anonymous local development leave the credential variables unset instead.
SPRING_KAFKA_BOOTSTRAPSERVERS=<kafka-host:port>
BRIDGE_MQTT_BROKERURI=<tcp://mqtt-host:port-or-ssl://mqtt-host:port>
BRIDGE_MQTT_CLIENTID=<unique-bridge-instance-id>
MQTT_USERNAME=<optional-mqtt-username>
MQTT_PASSWORD=<optional-mqtt-password>
# For authenticated Kafka also set standard spring.kafka properties, for example:
# SPRING_KAFKA_SECURITY_PROTOCOL=<SASL_SSL>
# SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=<broker-sasl-mechanism>
# SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=<jaas-config-with-credentials>
